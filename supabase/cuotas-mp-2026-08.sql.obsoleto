-- ELECTROWORLD: cuota 2 de 2, quedan 1 ($ 40.273) — ES LA ÚLTIMA
insert into public.cuotas (id, descripcion, tarjeta, monto_cuota, cuota_actual, cuota_total, fecha_primer_venc, estado, moneda, created_at)
