# Temporales de Drive
*.gdoc
*.gsheet
~$*

# Addon de terceros descargado (no redistribuir hasta decidir)
blender/addon.py
blender/*.png
blender/turntable/
# Backups automaticos de Blender: se reescriben en cada corrida, no aportan nada
blender/*.blend1
# Escenas intermedias de las etapas de crecimiento: se regeneran con
# especies_isla.py --etapa N --solo-blend, no hace falta versionarlas
blender/*_etapa*.blend

# Andamiaje de desarrollo (diagnostico y borradores, no van al repo)
# test_rosa.py SI se versiona: es la herramienta de validacion de 1 frame
blender/inspect_*.py
blender/render_test.py
demos/
n8n/

# Estado interno del Supabase CLI (no versionar)
supabase/.temp/
supabase/.branches/
# Secretos locales (nunca al repo): password de la DB, tokens, etc.
.env
.env.*

# Notas para retomar sesion: tienen refs de proyecto y prefijos de tokens
RETOMAR-ACA.md
